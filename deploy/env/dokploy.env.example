# PostgreSQL 16 interno ao Compose do POP RC; nao publicar a porta 5432.
DB_NAME=poprc
DB_USERNAME=poprc
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE

# O frontend fica publicado somente no loopback da VPS. O Nginx do host recebe
# o dominio HTTPS e encaminha para esta porta, sem expor o container na internet.
FRONTEND_HOST_PORT=8090
# Durante a homologacao sem DNS, pode ser https://IP_DA_VPS:9443.
APP_PUBLIC_URL=https://operacoes.exemplo.com.br
APP_VERSION=0.1.0
APP_REVISION=dokploy

REAUTHENTICATION_MINUTES=5
SESSION_TIMEOUT=8h

# Limites iniciais conservadores; ajustar somente depois da medicao no Dokploy.
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
DATABASE_MEMORY_LIMIT=512m
DATABASE_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_CPU_LIMIT=0.5

ALERT_EMAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=nao-configurado
MAIL_PASSWORD=nao-configurado
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
