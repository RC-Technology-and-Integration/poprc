server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name 186.196.9.178;

    ssl_certificate /etc/letsencrypt/live/186.196.9.178/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/186.196.9.178/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:POPrcHomologSSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 9443;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_request_buffering off;
    }
}
